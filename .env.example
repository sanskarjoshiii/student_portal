# Copy this file to ".env" and fill in as needed. All values are optional for
# local development — sensible defaults are used if you leave them out.

# A long random string used to sign cookies/tokens.
SECRET_KEY=change-me-to-a-long-random-string

# Base URL used to build links inside emails.
APP_URL=http://127.0.0.1:8000

# --- Admin-approval email ---
# Who receives admin-access approval requests.
SYSTEM_HEAD_EMAIL=premajoshi1100@gmail.com

# SMTP for real email. Leave these BLANK to use Django's console backend
# (emails are printed to the terminal instead of being sent).
# Gmail example (use a Google App Password, not your normal password):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=your-gmail@gmail.com
#   SMTP_PASS=your16charapppassword
#   SMTP_FROM=EventHub <your-gmail@gmail.com>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=premajoshi1100@gmail.com
SMTP_PASS=tgvzwifuqylfnmdg
SMTP_FROM=EventHub <premajoshi1100@gmail.com>
